{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "declaration": false,
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": ".homeybuild/",
    "rootDir": ".",
    "sourceMap": true,
    "strict": true,
    "types": ["node"]
  },
  "include": [
    "app.ts",
    "drivers/**/*.ts",
    "lib/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": [
    ".homeybuild",
    "node_modules"
  ]
}
